  "title": "Allow large borrowed responses without enlarging staging buffers",
  "user": {
    "login": "renerocksai",
    "id": 30892199,
    "node_id": "MDQ6VXNlcjMwODkyMTk5",
    "avatar_url": "https://avatars.githubusercontent.com/u/30892199?v=4",
    "gravatar_id": "",
    "url": "https://api.github.com/users/renerocksai",
    "html_url": "https://github.com/renerocksai",
    "followers_url": "https://api.github.com/users/renerocksai/followers",
    "following_url": "https://api.github.com/users/renerocksai/following{/other_user}",
    "gists_url": "https://api.github.com/users/renerocksai/gists{/gist_id}",
    "starred_url": "https://api.github.com/users/renerocksai/starred{/owner}{/repo}",
    "subscriptions_url": "https://api.github.com/users/renerocksai/subscriptions",
    "organizations_url": "https://api.github.com/users/renerocksai/orgs",
    "repos_url": "https://api.github.com/users/renerocksai/repos",
    "events_url": "https://api.github.com/users/renerocksai/events{/privacy}",
    "received_events_url": "https://api.github.com/users/renerocksai/received_events",
